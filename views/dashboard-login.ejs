<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — Trzciamajka</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      min-height: 100vh;
      color: #f1f5f9;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .card {
      background: rgba(30,41,59,0.8);
      border: 1px solid rgba(251,191,36,0.15);
      border-radius: 20px;
      padding: 40px;
      width: 360px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    }
    .card h1 { color: #fbbf24; text-align: center; margin-bottom: 24px; font-size: 1.4rem; }
    .card input {
      width: 100%; padding: 12px 16px;
      border: 1px solid rgba(251,191,36,0.2);
      border-radius: 10px;
      background: rgba(15,23,42,0.6);
      color: #f1f5f9; font-size: 1rem; margin-bottom: 16px;
    }
    .card input:focus { outline: none; border-color: #fbbf24; }
    .card button {
      width: 100%; padding: 12px;
      border: none; border-radius: 10px;
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      color: #0f172a; font-size: 1rem; font-weight: 700; cursor: pointer;
    }
    .card button:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(251,191,36,0.3); }
    .error { color: #f87171; text-align: center; margin-bottom: 16px; font-size: 0.9rem; }
  </style>
</head>
<body>
  <div class="card">
    <h1>🔐 Dashboard Organizatora</h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form method="POST" action="/login">
      <input type="password" name="password" placeholder="Hasło" autofocus />
      <button type="submit">Zaloguj</button>
    </form>
  </div>
</body>
</html>

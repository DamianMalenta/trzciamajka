<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel — Trzciamajka</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
      min-height: 100vh;
      color: #f1f5f9;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 30px;
      background: rgba(15,23,42,0.6);
      border-bottom: 1px solid rgba(251,191,36,0.15);
    }
    .header h1 {
      color: #fbbf24;
      font-size: 1.5rem;
    }
    .header a {
      color: #94a3b8;
      text-decoration: none;
      font-size: 0.9rem;
      padding: 8px 16px;
      border: 1px solid rgba(148,163,184,0.2);
      border-radius: 8px;
      transition: all 0.2s;
    }
    .header a:hover {
      color: #f1f5f9;
      border-color: rgba(148,163,184,0.4);
    }

    .container {
      max-width: 1000px;
      margin: 30px auto;
      padding: 0 20px 40px;
    }

    .ticket-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
      gap: 20px;
    }

    .ticket-item {
      background: rgba(30,41,59,0.7);
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(251,191,36,0.1);
      transition: all 0.2s;
    }
    .ticket-item:hover {
      border-color: rgba(251,191,36,0.25);
      transform: translateY(-2px);
    }

    .ticket-item-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 20px;
      background: rgba(15,23,42,0.4);
      border-bottom: 1px solid rgba(251,191,36,0.08);
    }
    .ticket-item-header h3 {
      color: #fbbf24;
      font-size: 1.1rem;
    }

    .ticket-item-body {
      display: flex;
      gap: 16px;
      padding: 16px 20px;
    }
    .ticket-item-body img {
      width: 120px;
      height: 120px;
      border-radius: 10px;
      object-fit: cover;
      flex-shrink: 0;
    }
    .ticket-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .ticket-info .info-row {
      font-size: 0.85rem;
      color: #94a3b8;
    }
    .ticket-info .info-row strong {
      color: #cbd5e1;
    }
    .ticket-info .hint-input {
      width: 100%;
      padding: 6px 10px;
      border: 1px solid rgba(251,191,36,0.15);
      border-radius: 6px;
      background: rgba(15,23,42,0.5);
      color: #f1f5f9;
      font-size: 0.85rem;
    }
    .ticket-info .hint-input:focus {
      outline: none;
      border-color: #fbbf24;
    }
    .ticket-info .save-hint {
      align-self: flex-start;
      padding: 4px 12px;
      border: none;
      border-radius: 6px;
      background: rgba(251,191,36,0.15);
      color: #fbbf24;
      font-size: 0.8rem;
      cursor: pointer;
      transition: all 0.2s;
    }
    .ticket-info .save-hint:hover {
      background: rgba(251,191,36,0.25);
    }

    .ticket-item-footer {
      padding: 14px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid rgba(251,191,36,0.08);
    }
    .status-label {
      font-size: 0.9rem;
      color: #94a3b8;
    }

    .toggle {
      position: relative;
      width: 52px;
      height: 28px;
      cursor: pointer;
    }
    .toggle input {
      opacity: 0;
      width: 0;
      height: 0;
    }
    .toggle-slider {
      position: absolute;
      inset: 0;
      background: #475569;
      border-radius: 14px;
      transition: 0.3s;
    }
    .toggle-slider::before {
      content: '';
      position: absolute;
      width: 22px;
      height: 22px;
      left: 3px;
      top: 3px;
      background: #f1f5f9;
      border-radius: 50%;
      transition: 0.3s;
    }
    .toggle input:checked + .toggle-slider {
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
    }
    .toggle input:checked + .toggle-slider::before {
      transform: translateX(24px);
    }

    .status-badge {
      padding: 3px 10px;
      border-radius: 12px;
      font-size: 0.8rem;
      font-weight: 600;
    }
    .status-found {
      background: rgba(34,197,94,0.15);
      color: #4ade80;
      border: 1px solid rgba(34,197,94,0.3);
    }
    .status-free {
      background: rgba(251,191,36,0.15);
      color: #fbbf24;
      border: 1px solid rgba(251,191,36,0.3);
    }

    .no-gps {
      color: #f87171;
      font-size: 0.8rem;
    }
    .code-display {
      color: #fbbf24;
      font-weight: 800;
      font-family: 'Courier New', monospace;
      letter-spacing: 0.2em;
      font-size: 1rem;
    }

    .gps-row {
      display: flex;
      gap: 6px;
      align-items: center;
    }
    .gps-input {
      width: 90px;
      padding: 4px 8px;
      border: 1px solid rgba(251,191,36,0.15);
      border-radius: 6px;
      background: rgba(15,23,42,0.5);
      color: #f1f5f9;
      font-size: 0.8rem;
    }
    .gps-input:focus {
      outline: none;
      border-color: #fbbf24;
    }
    .save-gps {
      padding: 4px 10px;
      border: none;
      border-radius: 6px;
      background: rgba(251,191,36,0.15);
      color: #fbbf24;
      font-size: 0.8rem;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .save-gps:hover {
      background: rgba(251,191,36,0.25);
    }
    .mini-map {
      width: 100%;
      height: 150px;
      margin-top: 8px;
      border-radius: 8px;
      border: 1px solid rgba(251,191,36,0.1);
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>🔐 Panel Admina — Trzciamajka</h1>
    <a href="/admin/logout">Wyloguj</a>
  </div>

  <div class="container">
    <div class="ticket-grid">
      <% tickets.forEach(ticket => { %>
        <div class="ticket-item">
          <div class="ticket-item-header">
            <h3>Bilet #<%= ticket.id %></h3>
            <span class="status-badge <%= ticket.is_found ? 'status-found' : 'status-free' %>">
              <%= ticket.is_found ? 'Znaleziony' : 'Wolny' %>
            </span>
          </div>
          <div class="ticket-item-body">
            <img src="<%= ticket.photo_path %>" alt="Bilet #<%= ticket.id %>" />
            <div class="ticket-info">
              <div class="info-row"><strong>GPS:</strong></div>
              <div class="gps-row">
                <input type="number" class="gps-input" id="lat-<%= ticket.id %>" placeholder="lat" step="0.000001" value="<%= ticket.lat != null ? ticket.lat : '' %>" />
                <input type="number" class="gps-input" id="lng-<%= ticket.id %>" placeholder="lng" step="0.000001" value="<%= ticket.lng != null ? ticket.lng : '' %>" />
                <button class="save-gps" onclick="saveGps(<%= ticket.id %>)">Zapisz</button>
              </div>
              <div class="mini-map" id="map-<%= ticket.id %>"></div>
              <div class="info-row"><strong>Wskazówka:</strong></div>
              <input type="text" class="hint-input" id="hint-<%= ticket.id %>" value="<%= ticket.hint_text %>" />
              <button class="save-hint" onclick="saveHint(<%= ticket.id %>)">Zapisz wskazówkę</button>

              <div class="info-row"><strong>Kod do odbioru:</strong> <span class="code-display"><%= ticket.code || '— brak —' %></span></div>
              <div class="gps-row">
                <input type="text" class="gps-input" id="code-<%= ticket.id %>" placeholder="np. K7M2" maxlength="4" value="<%= ticket.code || '' %>" style="text-transform:uppercase; letter-spacing:0.2em; width:120px;" />
                <button class="save-gps" onclick="saveCode(<%= ticket.id %>)">Zapisz kod</button>
              </div>
            </div>
          </div>
          <div class="ticket-item-footer">
            <span class="status-label">
              <%= ticket.is_found ? '✅ Znaleziony — wykluczony z losowania' : '🎯 Wolny — dostępny w losowaniu' %>
            </span>
            <label class="toggle">
              <input type="checkbox" <%= ticket.is_found ? 'checked' : '' %> onchange="toggleFound(<%= ticket.id %>, this.checked)" />
              <span class="toggle-slider"></span>
            </label>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    const maps = {};
    const markers = {};

    <% tickets.forEach(ticket => { %>
      (function() {
        const id = <%= ticket.id %>;
        const lat = <%= ticket.lat != null ? ticket.lat : 52.2297 %>;
        const lng = <%= ticket.lng != null ? ticket.lng : 21.0122 %>;
        const hasGps = <%= ticket.lat != null && ticket.lng != null %>;

        const map = L.map(`map-${id}`).setView([lat, lng], hasGps ? 15 : 5);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; OpenStreetMap', maxZoom: 19
        }).addTo(map);

        const marker = L.marker([lat, lng], { draggable: true }).addTo(map);
        if (!hasGps) {
          marker.bindPopup('Kliknij mapę lub przeciągnij pinezkę, aby ustawić GPS').openPopup();
        }

        marker.on('dragend', function(e) {
          const pos = e.target.getLatLng();
          document.getElementById(`lat-${id}`).value = pos.lat.toFixed(6);
          document.getElementById(`lng-${id}`).value = pos.lng.toFixed(6);
        });

        map.on('click', function(e) {
          marker.setLatLng(e.latlng);
          document.getElementById(`lat-${id}`).value = e.latlng.lat.toFixed(6);
          document.getElementById(`lng-${id}`).value = e.latlng.lng.toFixed(6);
        });

        maps[id] = map;
        markers[id] = marker;
      })();
    <% }) %>

    function toggleFound(id, checked) {
      fetch(`/admin/toggle/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({})
      })
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          location.reload();
        } else {
          alert('Błąd: ' + data.message);
        }
      });
    }

    function saveGps(id) {
      const lat = document.getElementById(`lat-${id}`).value;
      const lng = document.getElementById(`lng-${id}`).value;
      fetch(`/admin/gps/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lat: parseFloat(lat), lng: parseFloat(lng) })
      })
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          const btn = event.target;
          const orig = btn.textContent;
          btn.textContent = '✅ Zapisano!';
          setTimeout(() => btn.textContent = orig, 2000);
          if (markers[id]) {
            markers[id].setLatLng([data.lat, data.lng]);
            maps[id].setView([data.lat, data.lng], 15);
          }
        } else {
          alert('Błąd: ' + data.message);
        }
      });
    }

    function saveHint(id) {
      const hint = document.getElementById(`hint-${id}`).value;
      fetch(`/admin/hint/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hint_text: hint })
      })
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          const btn = event.target;
          const orig = btn.textContent;
          btn.textContent = '✅ Zapisano!';
          setTimeout(() => btn.textContent = orig, 2000);
        } else {
          alert('Błąd: ' + data.message);
        }
      });
    }

    function saveCode(id) {
      const code = document.getElementById(`code-${id}`).value;
      fetch(`/admin/code/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: code })
      })
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          const btn = event.target;
          const orig = btn.textContent;
          btn.textContent = '✅ Zapisano!';
          setTimeout(() => btn.textContent = orig, 2000);
          // Odśwież, żeby pokazać znormalizowany kod (wielkie litery).
          setTimeout(() => location.reload(), 800);
        } else {
          alert('Błąd: ' + data.message);
        }
      });
    }
  </script>
</body>
</html>

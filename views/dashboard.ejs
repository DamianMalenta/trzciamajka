<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — Trzciamajka</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      min-height: 100vh;
      color: #f1f5f9;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 24px;
      background: rgba(15,23,42,0.8);
      border-bottom: 1px solid rgba(251,191,36,0.15);
    }
    .topbar h1 { color: #fbbf24; font-size: 1.3rem; }
    .topbar .actions { display: flex; gap: 10px; align-items: center; }
    .topbar a, .topbar button {
      padding: 8px 16px;
      border: 1px solid rgba(148,163,184,0.2);
      border-radius: 8px;
      background: transparent;
      color: #94a3b8;
      text-decoration: none;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.2s;
    }
    .topbar a:hover, .topbar button:hover { color: #f1f5f9; border-color: rgba(148,163,184,0.4); }
    .topbar .prod-link {
      color: #4ade80;
      border-color: rgba(74,222,128,0.3);
    }

    .stats {
      display: flex;
      gap: 16px;
      padding: 20px 24px;
      max-width: 1200px;
      margin: 0 auto;
    }
    .stat-card {
      flex: 1;
      background: rgba(30,41,59,0.7);
      border: 1px solid rgba(251,191,36,0.1);
      border-radius: 12px;
      padding: 20px;
      text-align: center;
    }
    .stat-card .num { font-size: 2.5rem; font-weight: 800; }
    .stat-card .label { font-size: 0.85rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-top: 4px; }
    .stat-card.found .num { color: #4ade80; }
    .stat-card.free .num { color: #fbbf24; }
    .stat-card.total .num { color: #60a5fa; }

    .sync-status {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px 16px;
    }
    .sync-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.8rem;
    }
    .sync-badge.on { background: rgba(74,222,128,0.15); color: #4ade80; border: 1px solid rgba(74,222,128,0.3); }
    .sync-badge.off { background: rgba(248,113,113,0.15); color: #f87171; border: 1px solid rgba(248,113,113,0.3); }
    .sync-info { font-size: 0.8rem; color: #64748b; margin-top: 8px; }

    .bulk-actions {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px 20px;
      display: flex;
      gap: 12px;
    }
    .bulk-btn {
      padding: 10px 20px;
      border: 1px solid rgba(251,191,36,0.2);
      border-radius: 10px;
      background: rgba(30,41,59,0.7);
      color: #fbbf24;
      font-size: 0.9rem;
      cursor: pointer;
      transition: all 0.2s;
    }
    .bulk-btn:hover { background: rgba(251,191,36,0.1); }
    .bulk-btn.danger { color: #f87171; border-color: rgba(248,113,113,0.2); }
    .bulk-btn.danger:hover { background: rgba(248,113,113,0.1); }

    .tickets-grid {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px 40px;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 16px;
    }

    .ticket-card {
      background: rgba(30,41,59,0.7);
      border: 1px solid rgba(251,191,36,0.1);
      border-radius: 14px;
      overflow: hidden;
      transition: all 0.2s;
    }
    .ticket-card:hover { border-color: rgba(251,191,36,0.25); transform: translateY(-2px); }

    .ticket-card.found { border-color: rgba(74,222,128,0.3); }

    .ticket-card-img {
      width: 100%; height: 160px;
      object-fit: cover;
      display: block;
    }

    .ticket-card-body { padding: 14px 16px; }
    .ticket-card-body .row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .ticket-card-body .id { color: #fbbf24; font-weight: 700; font-size: 1rem; }
    .ticket-card-body .badge {
      padding: 3px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600;
    }
    .badge-found { background: rgba(74,222,128,0.15); color: #4ade80; border: 1px solid rgba(74,222,128,0.3); }
    .badge-free { background: rgba(251,191,36,0.15); color: #fbbf24; border: 1px solid rgba(251,191,36,0.3); }

    .ticket-card-body .gps { font-size: 0.8rem; color: #64748b; margin-bottom: 10px; }
    .ticket-card-body .hint { font-size: 0.85rem; color: #cbd5e1; margin-bottom: 12px; line-height: 1.4; }

    .toggle-btn {
      width: 100%;
      padding: 10px;
      border: none;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .toggle-btn.mark-found {
      background: linear-gradient(135deg, #22c55e, #16a34a);
      color: #fff;
    }
    .toggle-btn.mark-free {
      background: rgba(251,191,36,0.15);
      color: #fbbf24;
      border: 1px solid rgba(251,191,36,0.3);
    }
    .toggle-btn:hover { transform: translateY(-1px); }
    .toggle-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

    .toast {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      padding: 12px 24px;
      border-radius: 10px;
      font-size: 0.9rem;
      z-index: 1000;
      opacity: 0;
      transition: opacity 0.3s;
    }
    .toast.show { opacity: 1; }
    .toast.success { background: rgba(74,222,128,0.9); color: #0f172a; }
    .toast.error { background: rgba(248,113,113,0.9); color: #fff; }
  </style>
</head>
<body>
  <div class="topbar">
    <h1>🎟️ Dashboard Trzciamajka</h1>
    <div class="actions">
      <a href="<%= productionUrl %>" target="_blank" class="prod-link">↗ Produkcja</a>
      <form method="POST" action="/logout" style="display:inline">
        <button type="submit">Wyloguj</button>
      </form>
    </div>
  </div>

  <div class="stats">
    <div class="stat-card total">
      <div class="num"><%= total %></div>
      <div class="label">Wszystkie</div>
    </div>
    <div class="stat-card free">
      <div class="num"><%= free %></div>
      <div class="label">Wolne</div>
    </div>
    <div class="stat-card found">
      <div class="num"><%= found %></div>
      <div class="label">Znalezione</div>
    </div>
  </div>

  <div class="sync-status">
    <span class="sync-badge <%= githubEnabled ? 'on' : 'off' %>">
      <%= githubEnabled ? '✅ GitHub sync włączony' : '❌ GitHub sync wyłączony' %>
    </span>
    <% if (lastCommit) { %>
      <div class="sync-info">Ostatni commit: <%= lastCommit %></div>
    <% } %>
  </div>

  <div class="bulk-actions">
    <button class="bulk-btn" onclick="bulkAction('found-all')">Oznacz wszystkie znalezione</button>
    <button class="bulk-btn danger" onclick="bulkAction('free-all')">Reset — wszystkie wolne</button>
  </div>

  <div class="tickets-grid">
    <% tickets.forEach(ticket => { %>
      <div class="ticket-card <%= ticket.is_found ? 'found' : '' %>" id="card-<%= ticket.id %>">
        <img class="ticket-card-img" src="/zdjecia/<%= ticket.photo_file %>" alt="Bilet #<%= ticket.id %>" />
        <div class="ticket-card-body">
          <div class="row">
            <span class="id">Bilet #<%= ticket.id %></span>
            <span class="badge <%= ticket.is_found ? 'badge-found' : 'badge-free' %>" id="badge-<%= ticket.id %>">
              <%= ticket.is_found ? '✅ Znaleziony' : '🎯 Wolny' %>
            </span>
          </div>
          <div class="gps">
            <% if (ticket.lat != null) { %>
              📍 <%= ticket.lat.toFixed(6) %>, <%= ticket.lng.toFixed(6) %>
            <% } else { %>
              ⚠️ Brak GPS
            <% } %>
          </div>
          <div class="hint">💡 <%= ticket.hint_text %></div>
          <button class="toggle-btn <%= ticket.is_found ? 'mark-free' : 'mark-found' %>"
                  id="btn-<%= ticket.id %>"
                  onclick="toggleTicket(<%= ticket.id %>)">
            <%= ticket.is_found ? '↩️ Cofnij do wolnego' : '✅ Oznacz znaleziony' %>
          </button>
        </div>
      </div>
    <% }) %>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    function showToast(msg, type) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.className = 'toast ' + type + ' show';
      setTimeout(() => toast.classList.remove('show'), 3000);
    }

    function toggleTicket(id) {
      const btn = document.getElementById('btn-' + id);
      btn.disabled = true;
      btn.textContent = 'Synchronizacja...';

      fetch('/api/toggle/' + id, { method: 'POST' })
        .then(r => r.json())
        .then(data => {
          if (data.success) {
            // Odśwież kartę
            location.reload();
          } else {
            showToast(data.message || 'Błąd', 'error');
            btn.disabled = false;
          }
        })
        .catch(() => {
          showToast('Błąd połączenia', 'error');
          btn.disabled = false;
        });
    }

    function bulkAction(action) {
      if (!confirm(action === 'found-all' ? 'Oznaczyć wszystkie bilety jako znalezione?' : 'Zresetować wszystkie bilety na wolne?')) return;
      fetch('/api/' + action, { method: 'POST' })
        .then(r => r.json())
        .then(data => {
          if (data.success) {
            showToast(data.synced ? '✅ Zmiany wypchnięte na GitHub' : '⚠️ Zmienione lokalnie, sync nieudany', data.synced ? 'success' : 'error');
            setTimeout(() => location.reload(), 1500);
          }
        })
        .catch(() => showToast('Błąd połączenia', 'error'));
    }
  </script>
</body>
</html>
